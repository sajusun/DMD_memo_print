{
  "name": "dmd-memo-print",
  "productName": "Dinajpur Metallic Designs (DMD)",
  "version": "2.0.0",
  "description": "Enterprise Memo, Billing & Accounts Management Desktop Application",
  "main": "main.js",
  "license": "MIT",
  "author": "Sakhawat Hossain",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.dmd.memoprint",
    "productName": "Dinajpur Metallic Designs",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon/create-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "sql.js": "^1.14.2",
    "xlsx": "^0.18.5"
  }
}
